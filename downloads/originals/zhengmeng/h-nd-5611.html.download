:{"auid":170,"aid":11954145,"allow":true,"name":"外链文章","minVer":10},"newsCommentLength":0,"newsInfo":{"pictureId":"","id":5611,"imgPath":"//0.ss.508sys.com/image/rimage/fromSite/default/noimage.jpg","imgWidth":0,"imgHeight":0,"picAlt":"文章附图","title":"26年上中学《教育知识与能力》真题+答案","summary":"2026上半年教师资格证考试中学《教育知识与能力》真题一、单项选择题（本大题共21小题，每小题2分，共42分）1.在1917年初出刊的《新青年》杂志上以文言文发表《体育之研究》一文，明确阐述\u201C德智体\u201D三育并重的是（ &nbsp;）。A.陈独秀B.李大钊C.毛泽东D.恽代英2.在现代社会生产方式领域，通过教育提高劳动者对劳动过程的理解程度和劳动技能的熟练程度，从而提高劳动生产率，这表明教育在社会发展中具...","url":"/h-nd-5611.html","ndReqArgs":"{\"args\":{\"id\":5611,\"fromMid\":0},\"type\":31}","flag":0,"groupIds":[],"date":1774430520000,"dateStr":"2026-03-25","top":0,"views":275,"publishRegularly":false,"authStatus":0,"subTitle":"","groups":[],"isViewsOpen":true,"isQRCodeOpen":true,"author":"新媒体","source":"","link":"","comment":{"creator":"","validateCode":"/validateCode.jsp?88&validateCodeRegType=3"},"showCaptcha":false,"downLoadFiles":{},"prevNext":{"hasPrev":true,"prevId":5612,"prevIndep":false,"prevModuleIds":[],"prevNewsUrl":"/h-nd-5612.html","prevNewsTitle":"26年上中学《综合素质》真题+答案","hasNext":true,"nextId":5610,"nextIndep":false,"nextModuleIds":[],"nextNewsUrl":"/h-nd-5610.html","nextNewsTitle":"26年上幼儿园《综合素质》真题+答案"},"richContent":"<div class=\"jz_fix_ue_img\"><p style=\"text-autospace:ideograph-numeric;text-align:center\"><strong><span style=\"font-family:宋体;color:#000000;font-size:25px\">2026上半年教师资格证考试中学《教育知识与能力》真题<\/span><\/strong><\/p><p style=\"padding:0 0 0 0 \"><strong><span style=\"font-family:Calibri;color:#000000;font-size:17px\"><span style=\"font-family:宋体;\">一、单项选择题（本大题共<\/span>21<span style=\"font-family:宋体;\">小题，每小题<\/span><span style=\"font-family:Calibri;\">2<\/span><span style=\"font-family:宋体;\">分，共<\/span><span style=\"font-family:Calibri;\">42<\/span><span style=\"font-family:宋体;\">分）<\/span><\/span><\/strong><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">1.在1917年初出刊<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">的<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">《新青年》杂志上以文言文发表《体育之研究》一文<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">，<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">明确阐述<\/span><span style=\"font-family:宋体;\">\u201C德智体\u201D三育并重的是（<\/span><\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"> &nbsp; <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">）。<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">A.陈独秀<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">B.李大钊<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">C.毛泽东<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">D.恽代英<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">2.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">在现代社会生产方式领域<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">，<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">通过教育提高劳动者对劳动过程的理解程度和劳动技能的熟练程度<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">，<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">从而提高劳动生产率<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">，<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">这表明教育在社会发展中具有（<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"> &nbsp; <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">）。<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">A.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">经济功能<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">B.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">文化功能<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">C.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">政治功能<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">D.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">人口功能<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">3.有人提出教育既然是有目的地培养全面发展的人，就要给所有学生安排统一的教育内容、教育进度和教育方式，这样才能保证全体学生获得同等程度发展。这一观点主要违背了人身心发展的哪一规律？<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">（<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"> &nbsp; <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">）<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">A.顺序性<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">B.不平衡性<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">C.互补性<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">D.个体差异性<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">4.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"> 20世纪初<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">叶，<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">清政府以<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">\u201C<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">中学为体<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">，<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">西学为用<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">\u201D<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">为指导方针<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">，<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">以当时的日本学制为蓝本制定并实施的第一个现代学制是<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">（<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"> &nbsp; <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">）。<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">A<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">癸卯学制<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">B<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.壬寅<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">学制<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">C<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">壬子癸丑学制<\/span><\/p><p style=\"padding:0;margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">D<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">壬戌学制<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">5.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">随着生产力的发展和科学技术的进步<\/span>,为了提高劳动者的科学文化素质<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">，<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">一些国家开始普及义务教育<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">，<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">世界上最早提出并实行义务教育的国家是<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">（<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"> &nbsp; <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">）。<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">A<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">英国<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">B.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">德国<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">C.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">法国<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">D.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">美国<\/span><\/p><p style=\"padding:0 0 0 0 \"><span style=\"font-family:宋体;color:#000000;font-size:16px\">6.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">王老师向<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">全班同学<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">发<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">放<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">一份关于课<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">外<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">阅读情况<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">的<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">问卷，以<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">了<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">班里学<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">生<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">的<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">课外阅读<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">兴趣与<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">习惯<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">这种<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">研究方<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">法<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">属于<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">（<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"> &nbsp; <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">）。<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">A.调<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px;font-family:宋体;\">查法<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">B.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">观客法<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">C.实验<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">法<\/span><\/p><p style=\"padding:0 0 0 0 ;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">D.叙事研究法<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">7.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">崇实中学<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">结合<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">当地特色和课程<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">资源，开设了<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">\u201C唱<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">响<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">山歌<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">\u201D课，定期邀请当地知名演唱者到学校为同学们讲述歌词含义，教授演唱技巧，并带领同学们一起创编山歌。该课程的类型是<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">（<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"> &nbsp; <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">）。<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">A.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">隐性课<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">程<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">B.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">地方<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">课<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">程<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">C.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">校本课程<\/span><\/p><p style=\"padding:0 0 0 0 \"><span style=\"font-family:宋体;color:#000000;font-size:16px\">D.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">学科课程<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">8.初中数学李老师认为，只要教好数学，就完成了教学任务。至于学生思想品德方面的教育是道德与法治课任课教师和班主任的事情<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">,<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">与教学教师无关。李老师观点违背的教学过程规律是<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">（<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"> &nbsp; <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">）。<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">A.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">教学的教育性规律<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">B.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">学生认识的特殊性规律<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">C.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">传授知识与发展智力相统一规律<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">D.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">教师主导作用于学生主体地位相统一规律<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">9.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">李晓被评为学校的<\/span><span style=\"font-family:宋体;\">\u201C助人明星\u201D，班主任尚老师在班会上号召同学们向他学习。尚老师采用的德育方法是<\/span><\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">（<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"> &nbsp; <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">）。<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">A.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">说服教育法<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">B.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">榜样示范法<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">C.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">情景陶冶法<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">D.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">自我教育法<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">10.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">永勇经常迟到、旷课，多门功课不及格，但他短跑速度很快，在校运动会上连续两年获得百米赛跑冠军，班主任让他担任体育委员，发挥所长，培养他的荣誉感和责任心，并引导他努力学习。这位班主任贯彻的德育原则是<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">（<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"> &nbsp; <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">）。<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">A.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">理论联系实际<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">原则<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">B.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">严格要求与尊重学生相结合<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">原则<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">C.长<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">善救失<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">原则<\/span><\/p><p style=\"padding:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">D.集体教育与个别教育相结合原则<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">11.朱老师刚担任初一三班班主任发现，班级大小事务都得由老师决定，学生缺乏自主管理意识。为此，他开始遴选班委并制定公约。根据班级体发展阶段理论，该班级当前处于（ &nbsp; ）。 <\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">A.成熟阶段<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">B.核心形成阶段<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">C.组建<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">阶段<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">D.自主活动阶段<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">12.张老师经常引导学生体验不同类型音乐传达的情感和意境，一次音乐课上，他播放了一首民歌，在欣赏民歌的过程中，学生们虽然不明白歌词大意，但也能感受到歌曲表达的意境，这一过程体现知觉特性是<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">（<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"> &nbsp; <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">）。<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">A.选择性<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">B.整体性<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">C.理解性<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">D.恒常性<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">13.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">生物课上老师提问<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">：<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">带领团队从黄花<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">蒿<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">中分离出<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">青蒿<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">素用于治疗疟疾的中国科学家是谁，王亮举手回答，是屠呦呦，掌握这个知识点属于<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span> &nbsp; <span style=\"font-family:宋体;\">）。<\/span><\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">A<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">程序性知识<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">B<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">陈述性知识<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">C<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">元认知知识<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">D<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">经验性知识<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">14.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">张丽希望自己能够在考试中取得好成绩，<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">以<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">获得老师和家长的认可，为了达到目标，他制定了详细的学习计划，并严格执行，张丽的学习动机属于<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">（<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"> &nbsp; <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">）。<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">A<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">内部动机<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">B.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">外部动机<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">C<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">认知内驱力<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">D<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">生理内驱力<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">15.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">赵勇用<\/span><span style=\"font-family:宋体;\">\u201C干燥防失火，急躁必跺足\u201D这句话来分辨\u201C燥\u201D和\u201C躁\u201D<\/span><\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">，<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">避免把<\/span><span style=\"font-family:宋体;\">\u201C干燥\u201D写成\u201C干躁\u201D，或把\u201C急躁\u201D写成\u201C急燥\u201D<\/span><\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">这种学习策略属于<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">（<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"> &nbsp; <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">）。<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">A<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">复习策略<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">B<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">组织策略<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">C<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">概括性策略<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">D<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">精加工策略<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">16.在综合活动中，杨老师安排已掌握动画制作软件的高年级学生指导刚接触该软件的低年级学生设计二十四节气电子绘本。一段时间后，低年级学生能够独立完成电子绘本的制作，杨老师的做法主要依据的理论是<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">（<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"> &nbsp; <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">）。<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">A.人本主<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">义<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px;font-family:宋体;\">理论<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">B.认知发现理论<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">C.信息加工理论<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">D.社会建构理论<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">17.在\u201C榫卯结构创新设计\u201D课上，学生需要先在纸上画上不同榫卯结构的受力分析图，再通过建模软件模拟承重效果，最后制作实物模型来进行验证。根据皮亚杰认知发展阶段理论，这种先假设推理再实践验证的思维过程所体现的发展阶段是<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">（<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"> &nbsp; <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">）。<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">A.感知运算阶段<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">B.前运算阶段<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">C.具体运算阶段<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">D.形式运算阶段<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">18.课间，同学们在教室里聊天，刘明说：<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">\u201C<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">我的作业只剩下一半就写完了，真开心<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">\u201D<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">。而王华却说：<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">\u201C<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">我的作业只写了一半，还有一半没写完，真痛苦<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">\u201D<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">。这<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">一<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">现象反映了情绪具有<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">（<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"> &nbsp; <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">）。<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">A.主观性<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">B.感染性<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">C.情境性<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">D.两<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">极<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">性<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">1<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">9.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">方明精力充沛，直爽热情，好胜心<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">强<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">，但是<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">脾气<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">暴躁，不稳重，情绪产生快而强，能以<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">极<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">高的热情投入工作，但是常常缺乏耐心，难以坚持完<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">成<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">一项工作<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">方明的气质类型属于<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">（<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"> &nbsp; <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">）。<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">A<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">多血质<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">B<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">胆汁质<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">C<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">黏液质<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">D<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">抑郁质<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">20.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">物理课上，张老师在讲解完右手螺旋定则后，发现部分学生没有像预期的那样熟练掌握，他没有立刻<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">进入下一内容的讲解，而是通过演示帮助学生进一步理解。张老师这一做法体现的是<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">（<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"> &nbsp; <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">）。<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">A<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">教学操作能力<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">B.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">教学认知能力<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">C<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">教学监控能力<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">D<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px;font-family:宋体;\">教学评价能力<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">21.最近一段时间，刘晴不论上课还是做作业，甚至考试也忍不住想为什么眉毛长在眼睛上面，他虽然不断提醒自己没必要去想，可是还是控制不住<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">，<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">他的表现属于（<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"> &nbsp; <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">）。<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">A.焦虑<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">症<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">B.强迫<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">症<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">C.抑郁<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">症<\/span><\/p><p style=\"padding:0 0 0 0 \"><span style=\"font-family:宋体;color:#000000;font-size:16px\">D.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">恐惧症<\/span><\/p><p><strong><span style=\"font-family:Calibri;color:#000000;font-size:17px\"><span style=\"font-family:宋体;\">二、辨析题（本大题共<\/span>4<span style=\"font-family:宋体;\">小题，每小题<\/span><span style=\"font-family:Calibri;\">8<\/span><span style=\"font-family:宋体;\">分，共<\/span><span style=\"font-family:Calibri;\">32<\/span><span style=\"font-family:宋体;\">分）<\/span><\/span><\/strong><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">22.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">徐老师任教的班级中存在<\/span>5+2=0现象，五天学校教育的积极影响被两天周末的社会影响抵消，教育效果几乎为零。对此，徐老师认为，校外的社会环境影响起决定作用，对徐老师的观点做出辨析<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">。<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">23.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">求真中学二年级教研组开展关于学科课程综合实践活动课程与智育的关系问题讨论。在讨论中，赵老师认为，综合实践活动课程涉及的智育内容少，对智育作用不大，对赵老师的观点做出评析<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">。<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">24.以<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">《<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">我看到了什么<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">》<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">为题写作，小学生更多的描述客观世界景象，而初中生在描述客观世界的同时，突出了个人的喜好、烦恼和憧憬。孙老师认为初中生的写作特点是青春期自我意识高涨的表现，对孙老师的观点做出评析<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">。<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">25.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">有意注意是主动对一定事物发起的注意，无意注意是事先没有目的注意。周老师认为学生的学习只需要有意注意，与无意注意无关，对周老师的观点做出评析。<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p><strong><span style=\"font-family:Calibri;color:#000000;font-size:17px\"><span style=\"font-family:宋体;\">三、简答题（本大题共<\/span>4<span style=\"font-family:宋体;\">小题，每小题<\/span><span style=\"font-family:Calibri;\">10<\/span><span style=\"font-family:宋体;\">分，共<\/span><span style=\"font-family:Calibri;\">40<\/span><span style=\"font-family:宋体;\">分）<\/span><\/span><\/strong><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">26.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">简述中学体育的意义<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">。<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p style=\"margin-left:22px;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">27. <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">简述中学班主任的角色<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">。<\/span><\/p><p style=\"margin-left:22px;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p style=\"margin-left:22px;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">28.张林在阅读时遇到读不懂的内容便会慢慢再读一遍，或者退回到更前面的内容重新阅读，这种学习策略被称为元认知策略，简述元认知策略的内涵及分类。<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p style=\"margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">29.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">柯<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">尔伯格通过道德两难故事法，发现学生道德判断的发展呈现阶段性特点。简述<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">柯<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">尔伯格的道德发展阶段论。<\/span><\/p><p style=\"padding:0 0 0 0 ;text-align:justify;text-justify:inter-ideograph;margin:0;\"><span style=\"font-family:宋体;color:#000000;font-size:18px\"> &nbsp; <\/span><\/p><p><strong><span style=\"font-family:Calibri;color:#000000;font-size:17px\"><span style=\"font-family:宋体;\">四、材料分析题（本大题共<\/span>2<span style=\"font-family:宋体;\">小题，每小题<\/span><span style=\"font-family:Calibri;\">18<\/span><span style=\"font-family:宋体;\">分，共<\/span><span style=\"font-family:Calibri;\">36<\/span><span style=\"font-family:宋体;\">分）<\/span><\/span><\/strong><\/p><p style=\"margin-left:22px;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">30. <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">材料：<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">一位地理老师在讲授<\/span><span style=\"font-family:宋体;\">\u201C水土保持\u201D课时，将教学过程分成以下几个阶段：<\/span><\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>1）组织教学：概括讲授本课的教学目的、内容及有关步骤；<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>2）提出问题：学生观看黄河流域相关视频后，教师提出问题：黄河水为什么这么黄？为什么会含有大量泥沙？<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>3）感知教材：教师为学生提供黄河流域的资料（文字、图片等），让学生推想黄河带有大量泥沙的原因。<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>4）模拟实验：教室为学生提供泥土、水等材料，让学生用实验验证他们的推想。<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>5）小组讨论：学生在教师的指导下，分成几个小组，讨论水土流失的问题。<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>6）课堂小结：学生通过阅读材料，结合前面的研究，形成如何保持水土的结论；教师结合环境保护对学生进行情感、态度、价值观教育。<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">问题：结合材料，分析说明该教师贯彻了哪些教学原则。（<\/span>18分）<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"> &nbsp; <\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p style=\"padding:0 0 0 0 \"><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p style=\"margin-left:22px;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">31. <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">材料：<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">初三学生<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">徐<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">涛勤奋好学、严谨认真，但生性敏感在做事<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">上<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">过于追求完美。父母对他有很高的期望，对他的学习要求特别严格，为此他学习非常用功，成绩一直在班上名列前茅，但在一次考试中徐涛的成绩很不理想，他在学校受到老师的批评和同桌的取笑，回家后又遭到父母的严厉责备，导致心理负担过重。他认为自己难以达到父母的期待，而常常自责、内疚，觉得自己很没用，前途无望。之后，每次<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">考试<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">前好几天就开始紧张、不安，总担心自己考不好。在考试时他会感到呼吸急促、心慌、手发抖出汗，注意力难以集中，有时候脑子里一片空白，明明已经掌握的知识就是想不起来<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">，<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">考试成绩越来越差。<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">问题：<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>1）根据心理健康相关知识分析案例中徐涛的心理问题及成因<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>10分） <\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>2）针对徐涛出现的心理问题，给出合理的心理辅导建议<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>8分）<\/span><\/p><p style=\"text-autospace:ideograph-numeric;text-align:justify;text-justify:inter-ideograph\"><span style=\"font-family:宋体;color:#000000;font-size:25px\"> <\/span><\/p><p style=\"padding:0 0 0 0 ;text-autospace:ideograph-numeric;text-align:center\"><strong><span style=\"font-family:宋体;color:#000000;font-size:24px\">2026上半年教师资格证考试中学《教育知识与能力》答案<\/span><\/strong><\/p><p style=\"padding:0;margin-top:0;margin-bottom:0;margin-left:31px;\"><span style=\"font-family:宋体;color:#000000;font-size:17px\">一、 <\/span><strong><span style=\"font-family:宋体;color:#000000;font-size:17px\">单项选择题<\/span><\/strong><\/p><p style=\"padding:0 0 0 0 \"><span style=\"font-family:宋体;color:#000000;font-size:16px\">1.【答案】<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">C。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解析：<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">毛泽东<\/span><\/p><p style=\"padding:0 0 0 0 ;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">2.【答案】<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">A。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解析：<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">经济功能<\/span><\/p><p style=\"padding:0\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">3.【答案】<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">D。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解析：<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">个体差异性<\/span><\/p><p style=\"padding:0\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">4.【答案】<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">A。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解析：<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">癸卯学制<\/span><\/p><p style=\"padding:0\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">5.【答案】<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">B。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解析：<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">德国<\/span><\/p><p style=\"padding:0\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">6.【答案】<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">A。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解析：调查法<\/span><\/p><p style=\"padding:0\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">7.【答案】<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">C。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解析：校本课程<\/span><\/p><p style=\"padding:0\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">8.【答案】<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">A。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解析：教学的教育性规律<\/span><\/p><p style=\"padding:0\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">9.【答案】<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">B。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解析：榜样示范法<\/span><\/p><p style=\"padding:0\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">10<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">.<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">【答案】<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">C。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解析：长善救失<\/span><\/p><p style=\"padding:0\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">11.【答案】<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">C。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解析：组建阶段<\/span><\/p><p style=\"padding:0\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">12.【答案】<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">C。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解析：理解性<\/span><\/p><p style=\"padding:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">13.【答案】<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">B。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解析：<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">陈述性知识<\/span><\/p><p style=\"padding:0\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">14.【答案】<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">B。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解析：外部动机<\/span><\/p><p style=\"padding:0\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">15.【答案】<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">D。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解析：精加工策略<\/span><\/p><p style=\"padding:0 0 0 0 \"><span style=\"font-family:宋体;color:#000000;font-size:16px\">16.【答案】<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">D。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解析：社会建构理论<\/span><\/p><p style=\"padding:0\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">17.【答案】<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">D。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解析：形式运算阶段<\/span><\/p><p style=\"padding:0\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">18.【答案】<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">A。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解析：主观性<\/span><\/p><p style=\"padding:0\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">19.【答案】<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">B。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解析：胆汁质<\/span><\/p><p style=\"padding:0\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">20.【答案】<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">C。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解析：<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">教学<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">监控<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">能力<\/span><\/p><p style=\"margin-left:22px;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">21. <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">【答案】<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">B。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">解析：强迫症<\/span><\/p><p style=\"padding:0;margin-left:22px;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:31px;\"><span style=\"font-family:宋体;color:#000000;font-size:17px\">二、 <\/span><strong><span style=\"font-family:宋体;color:#000000;font-size:17px\">辨析题<\/span><\/strong><\/p><p style=\"margin-left:22px;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">22. <\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">【参考答案】<\/span><\/p><p style=\"padding:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">题干中徐老师的说法是错误的。<\/span><\/p><p style=\"padding:0\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>1）影响人身心发展的主要因素主要有遗传、环境、学校教育和个体的主观能动性。其中遗传是人身心发展的物质基础和<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">生物<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">前提<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">；<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">环境为个体的发展提供了多种可能，使遗传提供的发展可能性变成现实<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">；<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">学校教育<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">在人身心发展中<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">起主导作用<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">；<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">个体主观能动性起决定性作用。<\/span><\/p><p style=\"padding:0\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>2）徐老师认为\u201C校外社会环境影响起决定作用\u201D，夸大了社会环境的决定作用，忽视学校教育的主导作用和个体的主观能动性的决定性作用。<\/span><\/p><p style=\"padding:0\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>3）总之，人的发展是遗传、环境、教育和个体主观能动性共同作用的结果。学生不是被动接受影响的，教师可以通过家校合作、培养学生辨别能力和自我教育能力，将\u201C5+2=0\u201D转化为\u201C5+2&gt;7\u201D。<\/span><\/p><p style=\"padding:0\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">故题干中徐老师的说法是错误的。<\/span><\/p><p style=\"padding:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">23.【参考答案】题干中徐赵老师的说法是错误的。<\/span><\/p><p style=\"padding:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>1）智育，是指向学生传授系统科学知识和技能，培养和发展学生智力才能的教育活动。智育不仅包括知识传授，更强调能力发展。<\/span><\/p><p style=\"padding:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>2）综合实践活动课程是在教师引导下，学生自主进行的综合性学习活动，是基于学生的经验、密切联系学生自身生活和社会实际，体现对知识的综合应用的实践性课程。<\/span><\/p><p style=\"padding:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>3）综合实践活动课程对智育具有重要的促进作用。首先，它强调学生的亲身参与和实践探究，让学生在解决真实问题的过程中综合运用所学知识，这能加深对学科知识的理解与内化。其次，该课程注重培养学生的创新精神、批判性思维和动手操作能力，这些正是智育所追求的高阶智力才能。此外，通过综合实践活动，学生能激发学习兴趣，增强学习主动性，反过来促进学科课程的学习。<\/span><\/p><p style=\"padding:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span><span style=\"font-family:宋体;\">4）<\/span><\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">因此，赵老师只看到知识传授而忽视能力培养，对综合实践活动课程的智育价值认识不足。两类课程应相辅相成，共同促进学生智育发展。<\/span><\/p><p style=\"padding:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">故<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">题干中徐赵老师的说法是错误的。<\/span><\/p><p style=\"text-indent:0;margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">24.【参考答案】<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">题干中孙老师的观点是正确的。<\/span><\/p><p style=\"padding:0 0 0 0 \"><span style=\"font-family:宋体;color:#000000;font-size:16px\">初中生正处于青春期，青春期的个体更加关注自我，自我意识高涨，突出表现是青少年的<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">内心世界越发丰富，他们在日常生活和学校中，常常将很多心智用于自省。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">开始反复思考<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">\u201C我到底是个怎么样的人?\u201D\u201C我的特征是什么?\u201D\u201C别人喜欢我还是讨厌我?\u201D等一系列关于\u201C我\u201D的问题，这种倾向在其作文及日记中常可以清楚地观察到。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">所以<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">初中生在<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">作文写作时<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">描述客观世界的同时，突出个人的喜好、烦恼和憧憬<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">体现了自我意识的高涨。<\/span><\/p><p style=\"padding:0 0 0 0 \"><span style=\"font-family:宋体;color:#000000;font-size:16px\">故题干中孙老师的观点是正确的。<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\">25.【参考答案】<\/span><\/p><p style=\"margin-left:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">题干中周老师的观点是错误的。<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span><span style=\"font-family:宋体;\">1）有意注意<\/span><\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">是指有预定目的，需要经过意志努力而产生的注意。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">无意注意<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">是指没有预定目的，不加任何意志努力而产生的注意<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">。<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span><span style=\"font-family:宋体;\">2）<\/span><\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">在<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">学习过程<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">中，这两种注意是需要相互交替、协同作用的。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">学生需要<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">依靠有意注意来维持专注，克服学习中的困难，保证学习任务的完成<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">。但<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">单纯依靠有意注意进行学习，容易消耗身心能量，导致疲劳和厌倦。可以利用无意注意的规律来激发<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">学习<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">兴趣<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">，降低学习疲劳。因此<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">学生的学习需要有意注意<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">以及<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">无意<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">注意。<\/span><\/p><p style=\"padding:0 0 0 0 \"><span style=\"font-family:宋体;color:#000000;font-size:16px\">故题干中周老师的观点是错误的。<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;margin-left:31px;\"><span style=\"font-family:宋体;color:#000000;font-size:17px\">三、 <\/span><strong><span style=\"font-family:宋体;color:#000000;font-size:17px\">简答题<\/span><\/strong><\/p><p style=\"margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">26.【参考答案】<\/span><\/p><p style=\"padding:0 0 0 0 ;text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span><span style=\"font-family:宋体;\">1）学校体育可以促进学生身体健康的生长发育。 身体锻炼的每项运动，可以加速机体的新陈代谢，促进大脑皮质的兴奋和抑制活动，改善神经系统对各器官的调节作用，提高人的灵活性。&nbsp; &nbsp;<\/span><\/span><\/p><p style=\"padding:0 0 0 0 ;text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span><span style=\"font-family:宋体;\">2）体育与智育，德育，美育和综合实践活动是密切联系的。青少年学生体格强健才能为学习文化科学知识奠定必要的物质基础，才能有利于学习任务的完成。体育锻炼还可以使学生具有优美的体形与动作，体操、舞蹈更体现了体育与美育的巧妙结合。学生通过增强体质，也为进行综合实践活动提供了良好的条件。<\/span><\/span><\/p><p style=\"padding:0 0 0 0 ;text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span><span style=\"font-family:宋体;\">3）发展青少年体育，既是普及的需要，也是提高的需要。学生在学校打好了体育基础，走出校门就会成为各条战线开展体育活动的骨干力量，而且可以从中涌现一批批体育新苗，为我国体育运动攀登世界高峰不断输送新生力量。<\/span><\/span><\/p><p style=\"margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">27.【参考答案】<\/span><\/p><p style=\"padding:0 0 0 0 ;text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span><span style=\"font-family:宋体;\">1）班主任是一个教育型的管理者和学习型的指导者。管理的目的不是为了使学生就范，而是使他们在思想、学习、生活和健康等方面完善成长。指导学生学会学习应该是班主任工作的重要内容之一。<\/span><\/span><\/p><p style=\"padding:0 0 0 0 ;text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span><span style=\"font-family:宋体;\">2）班主任是学生的平等对话者和学生的心理工作者。班主任要有\u201C以学生为本\u201D的教育理念和尊重平等的意识，了解和掌握心理健康教育的基本理论和方法。<\/span><\/span><\/p><p style=\"padding:0 0 0 0 ;text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span><span style=\"font-family:宋体;\">3）班主任是一个学习者和家庭教育指导者。当今社会已经进入信息时代。在信息时代，班主任更需要学习，成为学生的榜样。班主任要成为家庭教育的指导者，以确保家庭教育与学校教育相一致。<\/span><\/span><\/p><p style=\"padding:0 0 0 0 ;text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span><span style=\"font-family:宋体;\">4）班主任是学校领导开展工作的骨干和助手。班主任工作的质量直接关系着学校工作的面貌和学生的成长状况，直接影响着党和国家教育方针的正确贯彻和教育目的的全面实现。<\/span><\/span><\/p><p style=\"padding:0 0 0 0 ;text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span><span style=\"font-family:宋体;\">5）班主任是各种教育力量和影响的控制者和协调者。班主任是学校与家庭、社会联系的桥梁，应利用各种教育因素和教育力量，为学生的成长和班级的发展提供良好的环境条件。<\/span><\/span><\/p><p style=\"text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">28.【参考答案】<\/span><\/p><p style=\"padding:0 0 0 0 ;text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">元认知策略是学生对自己认知过程的认知策略，主要包括元认知计划策略、元认知监视策略、元认知调节策略。<\/span><\/p><p style=\"text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">元认知计划是根据认知活动的特定目标，在一项认知活动之前计划各种活动，预计结果、选择策略，想出各种解决问题的方法，并预估其有效性。<\/span><\/p><p style=\"text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">元认知监视是在认知活动的实际过程中，根据认知目标及时评价、反馈自己认知活动的结果与不足，正确估计自己达到认知目标的程度、水平；并且根据有效性标准评价各种认知行动、策略的效果。<\/span><\/p><p style=\"padding:0 0 0 0 ;text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">元认知调节是根据对认知活动结果的检查，如发现问题，则采取相应的补救措施，根据对认知策略的效果的检查，及时修正、调整认知策略。<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">29.【参考答案】<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">柯尔伯格认为，儿童的道德发展普遍经历了<\/span>3种水平6个阶段的不变的发展顺序。<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span><span style=\"font-family:宋体;\">1）<\/span><\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">前习俗水平<\/span><\/p><p style=\"padding:0 0 0 0 \"><span style=\"font-family:宋体;color:#000000;font-size:16px\">第一阶段：避免惩罚和服从定向阶段<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">处于该阶段的儿童，对某种行为表现是对或错的判断，不是依据行为本身，而是依据行为带来的后果。<\/span><\/p><p style=\"padding:0 0 0 0 \"><span style=\"font-family:宋体;color:#000000;font-size:16px\">第二阶段：工具性的相对主义定向阶段<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">又名相对功利定向<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">该阶段儿童对行为的好坏判断是按行为的后果来确定的，对自己有利就好，对自己不利就是不好，没有主观的是非标准。<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span><span style=\"font-family:宋体;\">2）<\/span><\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">习俗水平<\/span><\/p><p style=\"padding:0 0 0 0 \"><span style=\"font-family:宋体;color:#000000;font-size:16px\">第三阶段：人际协调的定向阶段<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">，<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">又名寻求认可定向或好孩子定向。处于这一阶段的个体顺从传统要求，附和大众意见，期望得到别人的赞许，从而按照人们所说的<\/span><span style=\"font-family:宋体;\">\u201C好孩子\u201D的标准来约束自己的行为。<\/span><\/span><\/p><p style=\"padding:0 0 0 0 \"><span style=\"font-family:宋体;color:#000000;font-size:16px\">第四阶段：维护权威或秩序的定向阶段<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">，<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">又名遵守法规定向阶段。处于这一阶段的个体服从团体规范，严守公共秩序，尊重法律权威，这时判断是非已有了法制观念，但把规范视为固定不变。<\/span><\/p><p><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span><span style=\"font-family:宋体;\">3）<\/span><\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">后习俗水平<\/span><\/p><p style=\"padding:0 0 0 0 \"><span style=\"font-family:宋体;color:#000000;font-size:16px\">第五阶段：社会契约定向阶段<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">，<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">又名社会法制定向阶段。处于该阶段的个体认为，法律法规是维护或合乎社会大众利益的，如果社会习俗或者既定法律法规不合乎社会大众的利益，就应该加以修订。<\/span><\/p><p style=\"padding:0 0 0 0 \"><span style=\"font-family:宋体;color:#000000;font-size:16px\">第六阶段：普遍道德原则的定向阶段<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">，<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">又名普遍伦理定向阶段。处于这一阶段的个体有其个人的人生哲学，对是非善恶有其独立的价值标准。对事有所为有所不为，不受现实规范的限制。<\/span><\/p><p style=\"padding:0\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p style=\"margin-top:0;margin-bottom:0;\"><strong><span style=\"font-family:宋体;color:#000000;font-size:16px\">四、材料分析题<\/span><\/strong><\/p><p style=\"margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">30.【参考答案】<\/span><\/p><p style=\"text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">教师贯彻了直观性原则、启发性原则、理论联系实际原则、科学性与思想性相统一原则、循序渐进原则。<\/span><\/p><p style=\"text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>1）直观性原则。直观性原则是指在教学中教师要通过多种手段引导学生观察所学事物，或用生动形象的语言描述，引导学生形成关于所学事物、过程的清晰表象，丰富他们的感性知识，从而使他们能够正确理解书本知识和发展认识能力。材料中，教师通过播放黄河流域视频、提供文字和图片资料、组织泥土与水的模拟实验等方式，为学生提供了丰富的感性材料，体现了直观性原则。<\/span><\/p><p style=\"text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>2）启发性原则。启发性原则是指在教学中教师要充分发挥学生学习的主体作用，调动他们的学习主动性，引导他们独立思考，积极探索，生动活泼地学习，自觉地掌握科学知识，提高分析问题和解决问题的能力。材料中，教师在学生观看视频后，提出 \u201C黄河水为什么这么黄？\u201D\u201C为什么会含有大量泥沙？\u201D 等问题，引导学生主动思考；在学生推想后，又通过实验验证和小组讨论，让学生自主探究结论，体现了启发性原则。<\/span><\/p><p style=\"text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>3）理论联系实际原则。理论联系实际原则是指教学必须坚持理论与实际的结合与统一，用理论分析实际，用实际验证理论，使学生从理论与实际的结合中去理解和掌握知识，并学会运用理论知识去分析问题和解决问题，达到学懂会用、学以致用。材料中，教学内容紧密联系黄河流域水土流失的实际问题，从现实情境出发，让学生分析原因、讨论对策，用实验验证猜想，并最终形成保持水土的结论，体现了理论联系实际原则。<\/span><\/p><p style=\"text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>4）科学性与思想性相统一原则。科学性与思想性相统一原则是指教学要以马克思主义为指导，授予学生科学知识，并结合知识教学对学生进行社会主义品德和正确的价值观与世界观教育。材料中，在学生形成关于水土保持的科学结论后，教师结合环境保护对学生进行情感、态度、价值观教育，体现了科学性与思想性相统一原则。<\/span><\/p><p style=\"text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>5）循序渐进原则。循序渐进原则是指教学要按照学科的逻辑系统和学生认识发展的顺序进行，使学生系统地掌握基础知识和基本技能，形成严密的逻辑思维能力。材料中，地理老师在教学过程中按照\u201C组织教学\u2014\u2014提出问题\u2014\u2014感知教材\u2014\u2014模拟实验\u2014\u2014小组讨论\u2014\u2014课堂小结\u201D的顺序逐步深入，符合学生认识发展的规律，体现了循序渐进原则。<\/span><\/p><p style=\"text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">总之，材料中的教师贯彻了直观性原则、启发性原则、理论联系实际原则、科学性与思想性相统一原则、循序渐进原则，取得了较好效果，值得其他教师借鉴。<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p style=\"text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">3<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">1.【参考答案】<\/span><\/p><p style=\"text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>1）徐涛的心理问题属于考试焦虑。焦虑症是以与客观威胁不相适合的焦虑反应为特征的神经症。材料中徐涛在考试时会感到呼吸急促、心慌、手发抖出汗，注意力难以集中，属于考试焦虑的表现。<\/span><\/p><p style=\"text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">考试焦虑的成因：<\/span><span style=\"font-family:宋体;\">①家长对学生过高的期望；②学生个人过分地争强好胜；③学业上多次遭受失败；④个体自身具有容易引发焦虑反应的人格特质。<\/span><\/span><\/p><p style=\"text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">（<\/span>2）<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">针对徐涛的心理问题，可以采用以下心理辅导方法进行矫正：<\/span><\/p><p style=\"text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">①全身松弛训练法。全身松弛法，或称松弛训练，是通过改变肌肉紧张，减轻肌肉紧张引起的酸痛，以应付情绪上的紧张、不安、焦虑和气愤。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">当徐涛感到呼吸急促、紧张不安时，可采用全身松弛训练法缓解。<\/span><\/p><p style=\"text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">②系统脱敏方法。当某些人对某事物、某环境产生敏感反应（害怕、焦虑、不安）时，我们可以在当事人身上发展起一种不相容的反应，使对本来可引起敏感反应的事物，不再发生敏感反应。<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">可通过建立焦虑等级量表，逐个层级进行放松训练，最终消除徐涛的考试焦虑问题。<\/span><\/p><p style=\"text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">③合理情绪疗法。指导<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">徐涛<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\"><span style=\"font-family:宋体;\">在考试中使用正向的自我对话，如<\/span><span style=\"font-family:宋体;\">\u201C我能应付这个考试\u201D\u201C成绩并不重要，学会才是重要的\u201D\u201C无论考试的结果如何，都将不会是最后一次\u201D，对于缓解学生的考试焦虑，都有较好的效果。<\/span><\/span><\/p><p style=\"text-align:justify;text-justify:inter-ideograph;margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\">④强化法。根据学习原理，一个行为发生后，如果紧跟着一个强化刺激，这个行为就会再一次发生。当<\/span><span style=\"font-family:宋体;color:#000000;font-size:16px\">徐涛成绩提高时，教师应给予及时强化。<\/span><\/p><p style=\"margin-top:0;margin-bottom:0;\"><span style=\"font-family:宋体;color:#000000;font-size:16px\"> <\/span><\/p><p style=\"line-height:1.5em;\"><br /><\/p><\/div>","isOpenNewsSubTitle":false,"copyrightNoticeOpen":false,"copyrightNoticeContent":"声明：此篇为正蒙教育原创文章，转载请标明出处链接：","newsLink":"https://www.zhengmengjiaoyu.cn/h-nd-5611.html"},"isOnlyMember":false,"siteGfwNotAllow":false,"siteGfwNoticeTips":"为保障网络安全，该功能近期正在升级维护中，敬请期待！","newsGroupData":[]},"module433":{"id":433,"type":1,"style":7,"flag":0,"name":"图片","prop1":"ABUIABAEGAAg-IqsiQYo-4zrxwMw9AM49AM","prop2":0,"prop3":{"ide":"AHIIAhJmX3NjcmlwdDpTaXRlLmhvdmVyUXJDb2RlKCIvLzExOTU0MTQ1LnMyMWkuZmFpdXNyLmNvbS80L0FCVUlBQkFFR0FBZ2xJLUJpUVlvdllyZHZ3RXdrQU00a0FNLnBuZyIsdGhpcyk7","ib":true,"nf":false,"lt":0,"ln":"官方微博","url":"_script:Site.hoverQrCode(\"//11954145.s21i.faiusr.com/4/ABUIABAEGAAglI-BiQYovYrdvwEwkAM4kAM.png\",this,{\"tips\":\"请使用微博扫一扫\"});","reqArgs":""},"prop4":0,"prop5":"","prop7":{"mcf":-1,"br":0,"o":0,"st":0,"sx":0,"sy":0,"sb":6,"ss":0,"sc":"rgba(0, 0, 0, 0.20)","sm":{"w":0,"h":0,"l":0,"t":0},"ci":{"w":30,"h":30,"l":0,"t":0},"nid":"","brt":0,"niw":0,"nih":0,"nsrc":"//11954145.s21i.faiusr.com/4/ABUIABAEGAAg-IqsiQYo-4zrxwMw9AM49AM.png"},"blob0":{"jumpMode":0},"pattern":{"pc":{"by":1,"b":{"y":0},"s":{"t":0},"bg":{"y":0},"r":{"t":0},"rf":0,"mt":0.007291666666666667,"mr":0.39166666666666666,"ml":0.3709302325581395,"mb":0.0,"width":0.015625,"useLeft":true,"useRight":false,"mlV2":0.022603561046511626,"mrV2":0.0,"isUseCustom":true,"mh":false},"mobi":{"by":1,"bf":{"y":0},"bb":{"y":0},"mf":{"y":0},"bht":0,"b":{"y":0},"s":{"t":0},"bg":{"y":0},"r":{"t":0},"rf":0,"mt":0.013333333333333334,"mr":0.448,"ml":0.31385377659574465,"mb":0.0,"width":0.08,"useLeft":true,"useRight":false,"mlV2":0.10461792553191489,"mrV2":0.0,"isUseCustom":true,"mh":false}},"privatePattern":{"pc":{"ina":false,"ap":0,"hff":-1,"wff":-1,"lr":1,"hp":-1,"st":0},"mobi":{"ap":-1,"hff":-1,"wff":-1,"lr":1,"hp":-1,"br":0,"o":0,"sht":0,"sx":0,"sy":0,"sb":6,"sc":"rgba(0, 0, 0, 0.20)","brt":0,"ot":0,"st":0}},"commProp":{"al":[{"t":0},{"t":0}],"pa":{"mt":0,"t":0},"an":{"t":0},"im":0,"ps":{"t":0,"o":2},"ls":{"st":0},"more":{"moreType":0},"sa":{"open":0},"cal":[{"t":0}],"unst":true},"w":500,