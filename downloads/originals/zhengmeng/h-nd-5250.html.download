shop","minVer":89,"overseasVer":89,"overseasVerName":"网站海外版","overseasUpdateVerUrl":"//i.fkw.com/jump.jsp?t=40&siteVersion=1147&buySiteVer=true&siteSid=0&stdOrPopVer=2#appId=shop"}},{"linkIsShow":false,"open":"","iconClass":"faisco-icons-null jz_share_Tumblr","linkIcon":"分享到 Tumblr","name":"Tumblr","allow":true,"overseasOnlineServicesAuthInfo":{"auid":197,"aid":0,"allow":true,"updateVer":89,"updateVerName":"网站海外版","updateVerUrl":"//i.fkw.com/jump.jsp?t=40&siteVersion=1147&buySiteVer=true&siteSid=0&stdOrPopVer=2#appId=shop","minVer":89,"overseasVer":89,"overseasVerName":"网站海外版","overseasUpdateVerUrl":"//i.fkw.com/jump.jsp?t=40&siteVersion=1147&buySiteVer=true&siteSid=0&stdOrPopVer=2#appId=shop"}}],"lcid":{"qrcode":"二维码","newsDetailNotFound":"文章找不到","newsAttachDownloan":"附件下载","newsPrevOne":"上一篇","newsNextOne":"下一篇","share":"分享","siteFormNotLogin":"您没有登录，不能提交，请先","memberLoginLogin":"登录","productCommentCreator":"昵称","msgBoardContent":"内容：","hasNoComment":"暂无评论，快来发表吧~","comeToComment":"亲~快来评论噢！","verificationCode":"验证码","colon":"：","msgBoradChageValidateCode":"看不清，换一张","productCommentSubmit":"提交评论","anonymousUser":"匿名用户","daysAgo":"天前","yesterday":"昨天","hourAgo":"小时前","just":"刚刚"},"hideNews":false,"isCommentOpen":true,"isEmptyNews":false,"isNeedLogin":false,"currentNewsAttachAllow":true,"memberName":"","linkExternalNewsAuthInfo":{"auid":170,"aid":11954145,"allow":true,"name":"外链文章","minVer":10},"newsCommentLength":0,"newsInfo":{"pictureId":"","id":5250,"imgPath":"//0.ss.508sys.com/image/rimage/fromSite/default/noimage.jpg","imgWidth":0,"imgHeight":0,"picAlt":"文章附图","title":"2025上半年教师资格证笔试小学《综合素质》答案","summary":"2025上半年教师资格证笔试小学《综合素质》答案（考生回忆版）一、单项选择题1.黄老师说，每个学生的情况是不一样的，不能只根据成绩，每个学生都有自己的闪光点，都有自己的想法，我们应充分把 握的学生的潜力。其中说法不恰当的是 A.黄老师关注学生的主导性 B.黄老师关注学生的发展性 C.黄老师关注学生的主体性 D.黄老师关注学生的个体差异性 【答案】A 黄老师应关注学生的主导性 &nbsp;2.尊敬的老师...","url":"/h-nd-5250.html","ndReqArgs":"{\"args\":{\"id\":5250,\"fromMid\":0},\"type\":31}","flag":0,"groupIds":[115],"date":1767515580000,"dateStr":"2026-01-04","top":0,"views":73,"publishRegularly":false,"authStatus":0,"subTitle":"","groups":[{"id":115,"name":"教师资格笔试","url":"/h-nr.html?g=115"}],"isViewsOpen":true,"isQRCodeOpen":true,"author":"","source":"","link":"","comment":{"creator":"","validateCode":"/validateCode.jsp?267&validateCodeRegType=3"},"showCaptcha":false,"downLoadFiles":{},"prevNext":{"hasPrev":true,"prevId":5251,"prevIndep":false,"prevModuleIds":[],"prevNewsUrl":"/h-nd-5251.html","prevNewsTitle":"2025上半年教师资格证笔试幼儿园《保教知识与能力》","hasNext":true,"nextId":5249,"nextIndep":false,"nextModuleIds":[],"nextNewsUrl":"/h-nd-5249.html","nextNewsTitle":"青岛市市南区公开招聘2026年应届高校优秀毕业生简章"},"richContent":"<div class=\"jz_fix_ue_img\"><p style=\"text-autospace:ideograph-numeric;text-align:center;line-height:29px\"><strong><span style=\"color:#000000;font-size:19px\">2025上半年教师资格证笔试小学《综合素质》答案（考生回忆版）<\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px;font-family:微软雅黑;\">一、单项选择题<\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">1.黄老师说，每个学生的情况是不一样的，不能只根据成绩，每个学生都有自己的闪光点，都有自己的想法，我们应充分把 握的学生的潜力。其中说法不恰当的是 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.黄老师关注学生的主导性 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.黄老师关注学生的发展性 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.黄老师关注学生的主体性 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.黄老师关注学生的个体差异性 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">A 黄老师应关注学生的主导性 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#FF0000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">2.尊敬的老师，拿起笔来有很多的话想说，但不知要从何说起，也不知要用什么的语言来表达。我热爱您的一颗红热的心，一 切都可以忘记。只有您对我的谆谆教诲，让我永生难忘。可以 说明教师要成为学生的引路人。xxxx 说，我们要成为四个引路人，分别是？ <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">1.锤炼品格的引路人 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">2.学习知识的引路人 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">3.创新思维的引路人 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">4.奉献祖国 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">5.潜能唤醒 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">6.职业规划 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.2456 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.1345 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.2346 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.1234 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">D ①②③④ <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#FF0000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">3.老师树叶为什么会变黄？风筝为什么会飞？安安经常向姚老师提出各种千奇百怪的问题。姚老师每次都会尽其所能的耐心解答，并引导安安进一步思考。对此，不恰当的是： <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.姚老师注重培养学生思维能力 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.姚老师注重保护学生求知欲望 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.姚老师注重培养学生探究能力 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.姚老师注重培养学生实践意识 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">D 注重培养学生的实践意识 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#FF0000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">4.严老师偏爱学习好的学生，每次上课时对他们提出的问题总 是耐心解答，对学习不好的学生敷衍了事。说明严老师： <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">1、未能正确对待学生自主性； <\/span><span style=\"color:#FF0000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">2、未能正确对待学生发展顺序性； <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">3、未能正确对待学生发展整体性： <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">4、未能正确对待学生发展个体差异性 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.①②③④ <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.②④ <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.①②③ <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.①③④ <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">D ①③④ <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"> <\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">5.根据《中华人民共和国 x 法》。公民具有被选举权的起始年龄是。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.年满 20 周岁 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.年满 22 周岁 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.年满 16 周岁 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.年满 18 周岁 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">D 18 岁 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">6.某小学违规向学生收取课后服务费责令退还的机关是（ ） <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.教育行政部门 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.纪检部门 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.工商管理部门 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.公 a 部门 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">A 教育行政部门 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#FF0000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">7.某县教育行政部门为了将县**小学打造成\u201C明星学校\u201D ，在** 、经费投入等方面予以倾斜。该**教育行政部门的**()。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.合法。教育行政部门有教育规划的权利 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.合法。有利于该县教育质量的整体提升 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.不合法。教育行政部门应均衡配置教育资源 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.不合法。应按照学校的竞争力配置教育资源 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">C 不合法，教育行政部门应均衡配置教育资源 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">8.教师**认为自己参与学校**的权利受到了侵害，向教育行政 部门提出** 。被申诉人应是()。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.校长 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.校工会 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.学校 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.教代会 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">C 学校 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#FF0000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">9.小学生＊＊的父母不履行监护职责，经＊＊不改，被依法撤 销＊＊资格秦某的抚养费用应由（)。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A、指定的监护人负担 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B、秦某父母继续负担 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C、其他的近亲属负担 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D、社会福利部门承担 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">B 秦某父母继续负担 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">10.小学生王某因**辍学在家。依据《中*人*共**未成年人**法》，学校应当采取的**是()。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.对王某的父母给予行**罚 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.对王某的父母给予行**分 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.劝说王某返校复学 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.给予王某留*处理 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">C 劝说王某返校复学 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">11.小明美术课经美术老师赵某推荐出版，费用谁可以获取？ <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A ．小明 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B ．学校 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C ．赵某 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D ．小明和赵某 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">A 小明 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">12.某小学为**统一购买意外伤害** ，从中收取了一定的**费用。该校的做 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">法<\/span><span style=\"font-family:微软雅黑;\">( )。 <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.合法，学校有保护学生的义务 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.不合法，学校不得从中收取任何费用 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.合法，学校有自主管理的权利 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.不合法，学校只能从中收取少量费用 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">B 不合法，学校不得从中收取任何费用<\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#FF0000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">13.有学生口吃，老师把这几个口吃的学生叫在一起，分门别 类的进行了计划，这体现了这个老师公正的什么性。()。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.可互换性 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.灵活性 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.形式性 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.集体性 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">B 灵活性 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">14.新入职的**感觉教学上有些困难，便向经验丰富的**请教。 肖老师的下列做法中， **的是()。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.和马老师商讨教学环节并确定教学方案 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.推门听课并当场批评马老师的不妥之处 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.充分信任马老师让其独自探索积累教学经验 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.让马老师完全按照自己提供的教学设计完成教学 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">A 和马老师商讨教学环节并确定教学方案 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#FF0000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">15.**在班级管理中**了下列做法，其中正确的是()。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.设置\u201C违纪保证金\u201D来管理学生 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.规定学习优秀的学生才能担任班干部 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.将班上比较普遍的违纪现象在班会上进行讨论 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.每次考试后按照成绩排名依次让学生自己选择座位 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">C 将班上比较普遍的违纪现象在班会上进行讨论 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">16.老师发现学生们的成语没有学好，于是他调整了教学计划。 进行了成语接龙，这体现了下列的哪句话?()。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.智者必其量力所能从事焉 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.圣贤施教各尽其材 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.行而后知有道 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.教不倦仁也 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">B 圣贤施教，各尽其才<\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#FF0000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">17.不属于基本味觉的是(). <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.酸 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.甜 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.苦 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.辣 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">D 辣 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"> <\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">18.经过著名渔场北海渔场的是() <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.秘鲁寒流 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.北大西洋暖流 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.日本暖流 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.拉布拉多寒流 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">B 北大西洋暖流 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#FF0000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">19.夏朝将部落联盟转化为世袭国家的人是谁?( )。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.尧 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.舜 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.禹 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.启 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">D 启 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">20.公元 83 年法兰克王国查理大帝的三个孙子，签订了凡尔登条约，将领土分为三个部分大体奠定了下面欧洲三个国家的雏形（ ） <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.德国、瑞士、比利时 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.法国、瑞士、西班牙 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.德国、法国、意大利 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.法国、荷兰、比利时 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">C 德国、意大利、法国 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#FF0000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">21.在社会主义思想史上乌托邦是欧洲第一本空想社会主义著作，作者批判了封建社会和资本主义社会的罪恶，这本书的作者是（ ） <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.莫尔 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.欧文 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.傅立叶 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.圣西门 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">A 莫尔 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#FF0000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">22.史诗是由亚里士多德在其文学著作《诗学》中提出的，下面符合我国的长篇史诗是（ ） <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A 摩诃婆罗多 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.格萨尔王传 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.一列昂记 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.罗摩衍那 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">B 格萨尔王传<\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#FF0000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">23.维也纳音乐会常在金色大厅举行，金色在大厅在下面哪个国家？ <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.奥地利 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.意大利 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.德国 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px;font-family:微软雅黑;\">比利时<\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">A 奥地利 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">24.长城是中国历史上伟大的军事防御工程，被誉为天下第一关的是（ ） <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.娘子关 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.雁门关 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.山海关 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.嘉峪关 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">C 山海关 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#FF0000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">25.1956 年上映的电影《上甘岭》，其中的插曲叫什么名字？ <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.英雄赞歌 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.我的祖国 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.血染的风采 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.救亡主题曲 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">B 我的祖国 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">26.某小学四个班考试，一班:35 个人，平均分 74 分，二班:30个人，平均分 75 分，三班 32 个人，平均分 76 分，四班 40个人，平均分 72 分，全校的平均分是多少？ <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.74.1 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.74.3 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.75.4 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.75.5 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">A 74.1 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#FF0000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">27.在 Excel 表格中有如**所示的数据和选中状态。向下**A3单元格右下角的填充句柄到**单元格，A4、A5 单元格显示的 **分别是()。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.星期一星期一 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.星期二 星期二 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.星期一星期二 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.星期三星期四 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">D 星期三 星期四 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#FF0000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">28.下列和\u201C艺术-雕塑\u201D同一类别: <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">A.蔬菜-水果 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">B.违法-犯 Z <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">C.婚礼-婚纱 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">D.诗人-画家 <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">【答案】<\/span><span style=\"font-family:微软雅黑;\">B 违法--犯罪 <\/span><\/span><\/strong><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\"> <\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">29. <\/span><span style=\"color:#3E3E3E;font-size:14px\"><span style=\"font-family:微软雅黑;\">按照给出图形的<\/span><span style=\"font-family:微软雅黑;\">**特点，下列选项中，填入**处最恰当的是(<\/span><\/span><span style=\"color:#3E3E3E;font-size:14px\"> &nbsp; <\/span><span style=\"color:#3E3E3E;font-size:14px\"> <span style=\"font-family:微软雅黑;\">)。<\/span><\/span><\/p><p style=\"line-height:29px\"><br /><\/p><table cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;\"><tbody><tr><td width=\"-18.8667\" height=\"0\"><br /><\/td><td width=\"-18.8667\" height=\"0\"><br /><\/td><\/tr><tr><td><br /><\/td><td><img width=\"274\" height=\"170\" src=\"//fe.508sys.com/ueditor_1_2/image/menu/wordimg3.gif\" word_img=\"file:///C:/Users/ADMINI~1/AppData/Local/Temp/ksohtml10396/wps1.jpg\" _hidetool=\"true\" iswordimgtips=\"true\" style=\"width:181px;height:66px;\" / alt=\" \"><\/td><\/tr><\/tbody><\/table><span style=\"color:#000000;font-size:14px\"> <\/span><p><br /><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\">【答案】<\/span><\/strong><span style=\"color:#000000;font-size:14px\">C <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#FF0000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">二、<\/span><span style=\"font-family:微软雅黑;\">材料分析题<\/span><span style=\"font-family:微软雅黑;\">(本大题共 3 小题，每小题 14 分，共 42 分) <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">30. 材料： <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">父母溺爱孩子，老师与父母沟通但并未改进，老师放弃，偶然一次同学雨雨受伤，他热心助人，老师发现他的优点，并且热爱足球，老师不断表扬成绩越来越好。刚开始的时候，亮亮一开始上课不认真家长也不重视好像觉得学生也就这样了后来有一次在操场上，他背起同学去了医务室。老师发现他是一个好的孩子，所以以后亮亮每一次做一件好事。发现<\/span><span style=\"font-family:微软雅黑;\">亮亮擅长足球，鼓励亮亮发挥特长，亮亮就表现的越来越好<\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">然后老师就鼓励他。<\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px;font-family:微软雅黑;\">问题：从学生观角度，评析老师行为。<\/span><\/strong><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\">【参考答案】<\/span><\/strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">材料中教师的教育行为践行了<\/span><span style=\"font-family:微软雅黑;\">\u201C以人为本\u201D的学生观，体现了现代教育理念的核心要求，值得我们学习。 <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">（<\/span><span style=\"font-family:微软雅黑;\">1）学生是发展的人，具有巨大的发展潜能。 <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">材料中，教师突破<\/span><span style=\"font-family:微软雅黑;\">\u201C标签化\u201D思维，用动态眼光看待亮亮的成长。当发现其热心助人的品德闪光点后，通过持续正向激励（如公开表扬、特长培养）激活其内在动力，最终实现从\u201C学业后进生\u201D到\u201D全面进步者\u201D的转变。这印证了维果斯基\u201C最近发展区\u201D理论一一教育应着眼于学生潜在发展水平，通过引导实现跨越。 <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">（<\/span><span style=\"font-family:微软雅黑;\">2）学生是独特的人，每个学生都有自身的独特性。 <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">材料中，教师敏锐捕捉亮亮的足球天赋，将其转化为教育契机。通过组建班级足球队、推荐参加校队等方式，构建<\/span><span style=\"font-family:微软雅黑;\">\u201C特长发展支架\u201D ，帮助学生在优势领域建立自信，进而迁移到学业中。 <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"> <span style=\"font-family:微软雅黑;\">这种<\/span><span style=\"font-family:微软雅黑;\">\u201C以长促短\u201D的策略，体现了加德纳多元智能理论的实践智慧。 <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">（<\/span><span style=\"font-family:微软雅黑;\">3）学生是具有独立意义的人，是学习的主体。 <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">教师通过<\/span><span style=\"font-family:微软雅黑;\">\u201C助人行为强化一特长展示一目标设定\u201D的教育路径，逐步唤醒亮亮的自我认知。当亮亮在足球比赛中获得成就感后， 教师引导其制定学习目标，实现从\u201C外部驱动\u201D到\u201C自我驱动\u201D的转变，彰显了罗杰斯\u201C学生中心\u201D教育观的实践价值。 <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">（<\/span><span style=\"font-family:微软雅黑;\">4）学生是完整的人，需关注全面发展。 <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">教师突破<\/span><span style=\"font-family:微软雅黑;\">\u201C唯分数评价\u201D ，从品德（乐于助人）、体育（足球 特长）、学业（成绩提升）三个维度构建评价体系。通过组织主题班会分享助人故事、设立\u201C进步之星\u201D奖项等方式，促进学生社会性与个性的协同发展，践行了苏霍姆林斯基\u201C培养全面和谐发展的人\u201D的教育思想。 <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">结论：该教师的教育行为完整诠释了现代学生观的四大维度<\/span><span style=\"font-family:微软雅黑;\">--以发展性眼光挖掘潜能，以差异性视角发现价值，以主体性立场激发自觉，以整体性思维促进成长。这种\u201C眼中有人\u201D的教育智慧，为新时代教师处理\u201C问题学生\u201D转化提供了可复制的范式。 <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#FF0000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">31.材料： <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">李老师是一名新老师，入职之后他的师傅杜老师一直在鼓励帮助他。他也非常的努力除了上课之余一直泡在课堂里。学校的研发组要求李老师上公开课。杜老师听完了李老师的公开课后<\/span><span style=\"font-family:微软雅黑;\">一针见血的指出，李老师<\/span><span style=\"font-family:微软雅黑;\">&quot;只有自己，没有学生&quot; 。李老师想了想也认为自己在日常的教学活动中只是在关注自己想要交什么并不关注学生。他查阅了理论书籍之后，对自己的课堂做出了调整，变换了座位，设计了教学活动，课堂氛围变得越来越 活跃了。有一天他发现他的学生特别害怕他。在深入了解之后，他发现学生认为每次他都特别关注成绩，考试和作业，并进行排名，制作排行榜。李老师意识到自己的问题下定决心要改变。 <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">决定要缩小和学生之间的距离。问题：请从教师职业道德里面<\/span><span style=\"font-family:微软雅黑;\">的角度，评析李老师的行为。<\/span><\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px;font-family:微软雅黑;\">材料中李老师的教育行为践行了教师职业道德的要求，值得我们学习。<\/span><\/strong><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\">【参考答案】<\/span><\/strong><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">（<\/span><span style=\"font-family:微软雅黑;\">1）李老师做到了爱岗敬业。爱岗敬业要求教师忠诚于人民教育事业，勤恳敬业，甘为人梯，乐于奉献。材料中，李老师入职后主动向师傅学习，课余时间坚持听课，面对公开课反馈 能迅速调整教学策略，通过变换座位、设计互动活动等方式提升课堂效果，体现了对教育工作的高度责任感和专业追求。 <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">（<\/span><span style=\"font-family:微软雅黑;\">2）李老师做到了终身学习。终身学习强调教师应拓宽知识 视野，更新知识结构，潜心钻研业务。材料中，李老师在发现 教学问题后，通过查阅理论书籍改进教学方法，从\u201C关注自己教什么\u201D转向\u201C关注学生学什么\u201D ，展现了主动学习、与时俱进的职业素养，符合新时代教师专业发展要求。 <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">（<\/span><span style=\"font-family:微软雅黑;\">3）李老师做到了为人师表。为人师表要求教师坚守高尚情 操，知荣明耻，严于律己，以身作则。材料中，当发现学生因 成绩排名产生心理压力时，李老师能深刻反思自身问题，决心改变评价方式，努力缩小与学生的距离。这种自我修正的勇气 和教育智慧，为学生树立了良好的榜样。 <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">（<\/span><span style=\"font-family:微软雅黑;\">4）李老师做到了关爱学生。关爱学生要求教师要关心爱护全体学生，尊重学生的人格，平等公正对待学生。对学生严慈 相济，做学生的良师益友。材料中，李老师在被指出问题后，时刻关注学生的需求，综上所述，材料中李老师的教育行为充分体现了教师职业道德的核心内涵，为青年教师树立了职业发 展的典范。 <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">32.材料： <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">人为什么被说服说服不同于说理，说理注重的是过程，而说服只着眼于结果，只要能获得期待的结果，过程和手段在所不计。好的说理要求真实、逻辑合理、论据可靠。然而，即便是好的说理，也不一定能起到说服的效果。如果你跟对方说的理与他的利益不符（或者他根本不愿意说理），再好的说理也对他无法产生实际<\/span><span style=\"font-family:微软雅黑;\">影响。相比之下，说服指的是一种实际受影响的行为。非真实、<\/span><span style=\"font-family:微软雅黑;\">逻辑谬误、论据不可靠的宣传或误导，也可以产生这样的说服效果，它要的结果是<\/span><span style=\"font-family:微软雅黑;\">&quot;依从&quot; 。一个人想说服你，他的目的不只是要改变你的态度和看法，而且是要改变你的行为。他希望引发&quot;依从&quot; ，也就是使你的行为发生变化，变得与他的要求或目的相一致。当广告商为电视广告投入大量金钱时，他们不只是要你觉得他们的产品不错，而且是要你走进商店、掏出钱来购买这些产品。卖药的要你相信他们的针和药能让你的孩子变&quot;聪明&quot; ，道理也是一样的。说服可以诉诸认知，也可以诉诸情 绪。一般来说，人越是缺乏独立思考和分析的能力和习惯，就越是有可能被诉诸情绪的说服所影响。 &quot; ，另一种是&quot;外围途径&quot; ，前一个是切入要点（晓之以理），后一个是转弯抹角（诱之以情）。这两者的区别，其实也就是说理与说服的区别。 &quot; 中心途径&quot;指的是，人们仔细思考用于说服的信息、证据、逻辑，并根据这些说理因素的强弱来决定是否或如何改变自己的 看法和行为。 &quot;外围途径&quot;指的是，人们不是集中精力去分析和 评估信息，而是对信息情境的表面化暗示或联想直接做出反应。 <\/span><\/span><span style=\"color:#FF0000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">用名人、演员、歌星来为药品代言，不管是真药还是假药，走的都是<\/span><span style=\"font-family:微软雅黑;\">&quot;外围途径&quot; ，其信息情境提示的是像代言人一样的&quot;健康&quot;和&quot;优秀&quot; 。不能认识或抵御&quot;外围途径&quot;的情绪性说服，其结果经常是受骗上当，人们往往只是从不实商业广告的危害来认识抵抗情绪性说服的必要。其实，情绪性说服也发生在我们的社会和政治生活里，只是不容易被我们注意到而已。 <\/span><\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\">(1）说服和说理有什么区别？请简要概括 <\/span><\/strong><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\">(2）在我们日常生活当中如何防止受骗上当请结合材料简要分析。 <\/span><\/strong><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">（<\/span><span style=\"font-family:微软雅黑;\">1）①说理注重的是过程，说服只着眼于结果。 <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">②好的说理要求真实、逻辑合理、论据可靠；非真实、逻辑谬 误、论据不可靠的宣传或误导，也可以产生说服效果。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">③说理时所说的理与听者利益不符时，无法产生实际影响；说服指的是一种实际受影响的行为。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">（<\/span><span style=\"font-family:微软雅黑;\">2）①要不断增强独立思考和分析的能力和习惯，人越是缺乏独立思考和分析的能力和习惯，就越是有可能被诉诸情绪的说服所影响，就越有可能受骗上当。 <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">②受骗上当常常是因为受到说服过程中\u201C外围途径\u201D的影响， 要减少受骗上当就要集中精力去分析和评估信息，慎重对待信 息情境的表面化暗示或联想。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">③要抵御\u201C外围途径\u201D的情绪性说服，。就应理性看待名人、 演员、歌星的代言，不被情绪说服。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">④还应注意现实社会和政治生活中\u201C外围途径\u201D的情绪性说服的影响。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#FF0000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">三、写作题<\/span><span style=\"font-family:微软雅黑;\">(本大题 1 小题，50 分) <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">33.李生农业大学毕业后，为留城工作不停投放简历，到处面试，都不如愿。他冷静思考一番后，毅然返乡办起了养鸡场。 对此，村里人议论纷纷：＂大学四年白读了，真丢人。一定是在城里呆不下去了。＂李生坚持自己的选择，利用专业知识改进了饲养技术。数年后，他成了远近闻名的企业家，带领周边村民共同致富。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">要求<\/span><span style=\"font-family:微软雅黑;\">:用规范的现代汉语写作:角度自选，立意自定，标题自拟:不少于800字<\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"> <\/span><\/p><p style=\"line-height:29px\"><strong><span style=\"color:#000000;font-size:14px\">作文立意<\/span><\/strong><span style=\"color:#000000;font-size:14px;font-family:微软雅黑;\">：<\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px;font-family:微软雅黑;\">一等立意：<\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px;font-family:微软雅黑;\">这篇作文材料可从多个角度确立立意：<\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">1. 坚守自我，坚持梦想：李生未因村里人质疑而放弃返乡养鸡的选择，坚持梦想，最终成功。这启示人们在面对外界干扰时，要坚守内心追求，不被他人看法左右，勇敢逐梦。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">2. 知识的价值与运用：李生利用大学专业知识改进饲养技术取得成功，体现知识是宝贵财富，无论在城市还是乡村，将知识与实践结合，能创造价值，实现个人成长与社会贡献。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">3. 打破常规，勇于创新：李生毕业后不循规蹈矩在城市求职，而是返乡创业，打破大众认知，开辟新道路。表明在生活中， 不应局限于常规思维，要敢于突破传统，开拓创新，探索适合自己的发展方向。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">4. 正确看待职业选择：村里人对李生返乡创业存在偏见，而李生用事实证明职业无高低贵贱。我们应摒弃传统职业偏见，尊重不同职业选择，每个岗位都能实现人生价值。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">5. 个人发展与社会责任：李生成名后带领村民共同致富，体现他不仅实现个人价值，还主动承担社会责任。在追求个人成功时，不能忽视社会责任，应将个人发展与社会进步紧密相连 ，实现更大人生意义。 <\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">二等立意：<\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">写作建议<\/span><span style=\"font-family:微软雅黑;\">:可\u201C坚守自我\u201D \u201C正确看待职业选择/ <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\"><span style=\"font-family:微软雅黑;\">勇于选择适合自己的职业<\/span><span style=\"font-family:微软雅黑;\">\u201D\u201C个人发展与社会责任相结合\u201D <\/span><\/span><\/p><p style=\"line-height:29px\"><span style=\"color:#000000;font-size:14px\">等主题展开<\/span><\/p><p style=\"line-height:1.5em;\"><br /><\/p><\/div>","isOpenNewsSubTitle":false,"copyrightNoticeOpen":false,"copyrightNoticeContent":"声明：此篇为正蒙教育原创文章，转载请标明出处链接：","newsLink":"https://www.zhengmengjiaoyu.cn/h-nd-5250.html"},"isOnlyMember":false,"siteGfwNotAllow":false,"siteGfwNoticeTips":"为保障网络安全，该功能近期正在升级维护中，敬请期待！","newsGroupData":[{"id":115,"name":"教师资格笔试","href":"/h-nr.html?g=115"}]},"module429":{"id":429,"type":1,"style":6,"flag":0,"name":"文本","prop3":[],"prop5":[],"blob0":{"jumpMode":0},"pattern":{"pc":{"by":1,"b":{"y":0},"s":{"t":0},"bg":{"y":0},"r":{"t":0},"rf":0,"mt":0.017708333333333333,"mr":0.011556094629782118,"ml":0.03869928560300892,"mb":0.0,"width":0.521125,"useLeft":false,"useRight":true,"mlV2":0.0,"mrV2":0.006343814447807476,"isUseCustom":true,"mh":false},"mobi":{"by":1,"bf":{"y":0},"bb":{"y":0},"mf":{"y":0},"bht":0,"b":{"y":0},"s":{"t":0},"bg":{"y":0},"r":{"t":0},"rf":0,"mt":0.02666,"mr":0.03733,"ml":0.03733,"mb":0.01333,"width":0.925416,"useLeft":false,"useRight":false,"mlV2":0.0,"mrV2":0.0,"isUseCustom":true,"mh":false}},"content":"<span style=\"color: rgb(205, 205, 205); font-size: 16px;\">关于正蒙丨新闻活动丨正蒙频道丨联系我们丨加入正蒙丨面授课程丨正蒙网校丨备考神器丨教师资格证丨教师招考丨学历提升丨新媒体矩阵<\/span>","privatePattern":{"pc":{"fts":{"t":0},"ap":2,"ft":0,"fmax":-1,"fmin":-1,"ec":0,"fr":-1,"frs":-1},"mobi":{"pmf":{"s":12,"f":"微软雅黑","c":"#212121","ta":0,"d":0,"i":0,"w":0,"lh":18,"s_f":true,"c_f":false,"ta_f":true,"d_f":false,"i_f":false,"w_f":false,"lh_f":true,"f_f":false,"lhir":false,"lhre":0,"ws":0,"ws_f":false},"cs":1,"csf":f